ENV=dev
# postgres for real use; memory keeps everything in process (lost on restart).
STORAGE=postgres
# A Neon or Supabase URL can be pasted as-is; it is converted for asyncpg automatically,
# including their pooled (PgBouncer) URLs.
DATABASE_URL=postgresql+asyncpg://haq:haq@localhost:5432/haq
# Production: a random string of 32+ characters (the server refuses to start otherwise).
JWT_SECRET=change-me-to-a-long-random-string
# tesseract reads real photos; mock returns known fields for the bundled sample images.
EXTRACTOR=tesseract
OCR_LANGUAGES=eng,hin+eng
# Windows only, if tesseract.exe is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CORS_ORIGINS=["http://localhost:5173"]
# Optional, e.g. for Vercel preview URLs: https://haq-[a-z0-9-]+\.vercel\.app
# CORS_ORIGIN_REGEX=
MAX_UPLOAD_MB=8
# Requests per client IP per minute.
RATE_LIMIT_UPLOADS=12
RATE_LIMIT_AUTH=30
LOG_LEVEL=INFO
# true in production: one JSON object per log line.
LOG_JSON=false
# Password for the demo Bank Mitra accounts. Optional locally (defaults to the documented
# demo password); required in production for the accounts to be created.
# SEED_OPERATOR_PASSWORD=
