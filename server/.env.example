ENV=dev
# postgres for real use; memory keeps everything in process (lost on restart).
STORAGE=postgres
# A Neon URL can be pasted as-is; it is converted for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://haq:haq@localhost:5432/haq
JWT_SECRET=change-me-to-a-long-random-string
EXTRACTOR=mock
# Optional; only synthetic demo images may ever be sent to the Gemini free tier.
GEMINI_API_KEY=
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_MB=8
