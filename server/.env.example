ENV=dev
# postgres for real use; memory keeps everything in process (lost on restart).
STORAGE=postgres
# A Neon URL can be pasted as-is; it is converted for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://haq:haq@localhost:5432/haq
JWT_SECRET=change-me-to-a-long-random-string
# tesseract reads real photos; mock returns known fields for the bundled sample images.
EXTRACTOR=tesseract
OCR_LANGUAGES=eng,hin+eng
# Windows only, if tesseract.exe is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CORS_ORIGINS=["http://localhost:5173"]
MAX_UPLOAD_MB=8
